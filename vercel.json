{
  "version": 2,
  "builds": [
    {
      "src": "api/[[...slug]].ts",
      "use": "@vercel/node",
      "config": {
        "include": ["src/**/*", "api/**/*", "package.json", "tsconfig.json"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/[[...slug]].ts"
    }
  ]
}
